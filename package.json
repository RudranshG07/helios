{
  "name": "helios-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts",
    "sense:probe": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/sense/probe.ts",
    "swap:probe": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/execute/probe.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ethers": "^6.13.4",
    "viem": "^2.52.2",
    "x402-fetch": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2"
  }
}
